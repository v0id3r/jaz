# AppArmor profile for Jaz agent sessions started by `jaz runner` (podman).
# It is podman's containers-default profile, except that signal and ptrace
# rules also match the label stacked with crun's own profile on Ubuntu 24.04+
# (crun//&jaz-session); containers-default denies those, so init could not
# forward SIGTERM and agents could not signal their own children.
#include <tunables/global>

profile jaz-session flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  unix,
  capability,
  file,
  umount,

  signal (receive) peer=unconfined,
  signal (send,receive) peer={jaz-session,crun//&jaz-session},
  signal (receive) peer={/usr/bin/,/usr/sbin/,}runc,
  signal (receive) peer={/usr/bin/,/usr/sbin/,}crun*,
  signal (receive) peer={/usr/bin/,/usr/sbin/,}podman,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read) peer={jaz-session,crun//&jaz-session},
}
