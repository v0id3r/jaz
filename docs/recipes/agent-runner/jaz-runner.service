[Unit]
Description=Jaz agent runner (podman sessions)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/libexec/jaz/jaz runner --config /etc/jaz/runner.yaml
RuntimeDirectory=jaz-runner
RuntimeDirectoryMode=0755
# The Jaz container bind-mounts /run/jaz-runner; keep the directory across restarts.
RuntimeDirectoryPreserve=yes
Restart=on-failure
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
